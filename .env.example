# No real secrets should be committed. Use long random values in production.
MONGODB_URI=mongodb://127.0.0.1:27017/waste-well-placed
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_EMAIL=hello@example.co.uk
NEXT_PUBLIC_COMPANY_PHONE=+440000000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=
