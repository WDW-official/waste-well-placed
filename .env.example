# Copy required values into your private .env or deployment settings.
# Never commit real credentials. Existing encryption keys must be preserved.
MONGODB_URI=
SESSION_SECRET=
DRIVER_DATA_KEY=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test credentials first; configure the webhook endpoint in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Use a sender that is verified with your email provider.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Optional public contact shortcuts. Approved company details/policies are
# managed by the owner under /admin/settings.
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
